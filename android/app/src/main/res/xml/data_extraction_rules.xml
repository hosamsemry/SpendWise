<?xml version="1.0" encoding="utf-8"?>
<!--
  SpendWise keeps all financial data on the device. Exclude everything from
  Google cloud backup and from device-to-device transfer (Android 12+), where
  android:allowBackup="false" alone does not stop D2D transfer.
  Users move data with the in-app backup file instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
